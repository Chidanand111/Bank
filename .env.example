# ==========================================
# BankMock Environment Configuration
# ==========================================

# PostgreSQL Connection String
# Examples:
# Neon / Supabase: postgresql://postgres:[PASSWORD]@[HOST].supabase.co:5432/postgres?sslmode=require
# Railway / Render: postgresql://postgres:[PASSWORD]@[HOST]:5432/railway?sslmode=require
DATABASE_URL="postgresql://username:password@remote-db-host.com:5432/bankmock?sslmode=require"

# Session Encryption Secret
SESSION_SECRET="bankmock_production_secure_session_secret_key_2025"

# Development Seed Credentials (Optional overrides)
DEV_ADMIN_EMAIL="admin@bankmock.com"
DEV_ADMIN_PASSWORD="admin123"
DEV_USER_EMAIL="student@bankmock.com"
DEV_USER_PASSWORD="user123"
